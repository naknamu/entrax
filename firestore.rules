rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================================================
    // SECURITY RULES FOR ONLINE EXAM PLATFORM
    // ==========================================================================
    //
    // Phase 0.3 (server-side grading) is behind a feature switch:
    //   config/features { serverGrading: true }
    //
    // When the switch is ON:
    // - `examKeys/{examId}` holds correct answers (admin-only; Admin SDK writes).
    // - The `submitAttempt` Cloud Function grades and writes score fields.
    // - Clients may only create an empty draft and autosave answers/flags.
    // - Exam documents should have `correctIndex` stripped (migration script).
    //
    // When the switch is OFF (legacy):
    // - Grading happens in the browser and `correctIndex` stays in the exam doc.
    // - Published exams, including future/closed ones, are listable and expose
    //   `correctIndex`. Do not charge money in this mode.
    //
    // Students must be real (magic-link) users. Anonymous direct-link sessions
    // are rejected for exam reads and submissions.
    // ==========================================================================

    // Helper functions
    function isAdmin() {
      // Admins are identified by a custom claim granted with the Admin SDK
      // (scripts/set-admin-claim.cjs). A student account can never grant this
      // to itself, and rules stay cheap: no extra document lookup.
      // .get() avoids a rule-evaluation error when the claim is absent.
      return request.auth != null && request.auth.token.get('role', '') == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // A real (magic-link / email) user, not an anonymous direct-link session.
    function isRealUser() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function examExists(examId) {
      return exists(/databases/$(database)/documents/exams/$(examId));
    }

    function featureDoc() {
      return /databases/$(database)/documents/config/features;
    }

    function serverGradingEnabled() {
      return exists(featureDoc()) &&
             get(featureDoc()).data.get('serverGrading', false) == true;
    }

    // A published exam with questions that has started (open or already closed).
    // Used for `get`: review=true must still work after the window closes, so
    // this deliberately ignores endDate. Drafts and not-yet-open exams stay
    // hidden. Published future/closed exams remain `list`able; once
    // serverGrading is enabled, `correctIndex` is no longer in the exam doc.
    function isExamReadable(examId) {
      let exam = get(/databases/$(database)/documents/exams/$(examId));
      let start = exam.data.get('startDate', null);
      return isRealUser() &&
             exam.data.get('status', '') == 'published' &&
             exam.data.get('questions', []).size() > 0 &&
             (start == null || start <= request.time);
    }

    // A published exam with questions that is inside its availability window.
    // Used for starting/submitting attempts.
    function isExamOpen(examId) {
      let exam = get(/databases/$(database)/documents/exams/$(examId));
      let now = request.time;
      let start = exam.data.get('startDate', null);
      let end = exam.data.get('endDate', null);
      // .get() keeps legacy docs without these fields from aborting evaluation.
      return exam.data.get('status', '') == 'published' &&
             exam.data.get('questions', []).size() > 0 &&
             (start == null || start <= now) &&
             (end == null || end >= now);
    }

    // Allow users to read their own exams (for category loading, dashboard, etc.)
    function isOwnExam() {
      return request.auth != null && resource.data.get('createdBy', '') == request.auth.uid;
    }

    // True when the submission belongs to the caller (uid, or legacy email).
    function isSubmissionOwner() {
      return resource.data.get('studentUid', '') == request.auth.uid ||
             (request.auth.token.get('email', '') != '' &&
              resource.data.get('studentEmail', '') == request.auth.token.get('email', ''));
    }

    // A client-created draft must not carry grading results. The callable writes
    // those with the Admin SDK, which bypasses rules.
    function draftShapeOk() {
      return request.resource.data.get('submittedAt', null) == null &&
             request.resource.data.get('score', 0) == 0 &&
             request.resource.data.get('percentage', 0) == 0 &&
             request.resource.data.get('passed', false) == false &&
             request.resource.data.get('gradedBy', '') == '';
    }

    // ==========================================================================
    // CONFIG (feature flags)
    // ==========================================================================
    match /config/features {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================================================
    // EXAM ANSWER KEYS (server grading only)
    // ==========================================================================
    // Never readable by students. Admin pages may read them to edit/preview
    // exams whose `correctIndex` has been stripped.
    match /examKeys/{examId} {
      allow read, write: if isAdmin();
    }

    // ==========================================================================
    // EXAMS COLLECTION
    // ==========================================================================
    match /exams/{examId} {
      // Admins can create exams
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;

      // Admins can read all exams (for dashboard)
      // Users can read their own exams (for category loading, editing)
      // Students can `get` a started, published exam (taking it, or reviewing a
      // past attempt after the window closes). Drafts and not-yet-open exams are
      // not gettable.
      allow get: if isAdmin() || isOwnExam() || (!isAdmin() && isExamReadable(examId));
      // list = query — rules are not filters, so the client query must be
      // provable from the constraints. Students can list every published exam,
      // including future/closed ones; drafts are admin-only. With server
      // grading on, those documents no longer contain `correctIndex`.
      allow list: if isAdmin() || (isRealUser() && resource.data.get('status', '') == 'published');

      // Admins manage ALL exam content. Ownership is deliberately not checked:
      // legacy production exams carry a hardcoded foreign `createdBy` uid
      // (scripts/batch-create-exams.cjs), and a single-tenant product trusts
      // its admins. New exams must still be created under the caller's uid.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // SUBMISSIONS COLLECTION
    // ==========================================================================
    match /submissions/{submissionId} {
      // Students can CREATE a draft attempt. With server grading on, the doc
      // must be empty of results and its start time must be server-set.
      allow create: if
        isRealUser() &&
        examExists(request.resource.data.examId) &&
        isExamOpen(request.resource.data.examId) &&
        request.resource.data.get('studentUid', '') == request.auth.uid &&
        request.resource.data.get('studentName', '') != '' &&
        request.resource.data.get('studentEmail', '') != '' &&
        request.resource.data.get('startedAt', null) != null &&
        request.resource.data.get('answers', null) != null &&
        (!serverGradingEnabled() ||
          (draftShapeOk() && request.resource.data.startedAt == request.time));

      // Students can READ their own submission (after submitting).
      // Admins can read everything. Legacy submissions that predate
      // `studentUid` are still readable by their auth email.
      allow get: if isAdmin() || (isRealUser() && isSubmissionOwner());
      allow list: if isAdmin() || (isRealUser() && isSubmissionOwner());

      // Students can UPDATE their own UNSUBMITTED draft (autosave). The final
      // submit is the transition submittedAt == null -> timestamp. With server
      // grading on, only autosave fields may change; the callable writes the
      // graded result with the Admin SDK.
      allow update: if
        isAdmin() ||
        (isRealUser() &&
         isSubmissionOwner() &&
         resource.data.get('submittedAt', null) == null &&
         (!serverGradingEnabled() ||
           (request.resource.data.get('submittedAt', null) == null &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answers', 'flaggedQuestions', 'lastSavedAt', 'tabSwitchCount']))));

      // No deletes for submitted submissions (audit trail). A student may
      // remove their own draft (retake / abandoned attempt).
      allow delete: if isAdmin() ||
        (isRealUser() &&
         resource.data.get('studentUid', '') == request.auth.uid &&
         resource.data.get('submittedAt', null) == null);
    }

    // ==========================================================================
    // STUDENTS COLLECTION
    // ==========================================================================
    match /students/{uid} {
      // Students can read their own profile
      allow read: if isRealUser() && request.auth.uid == uid;

      // Students can create their own profile (first sign-in)
      allow create: if isRealUser() && request.auth.uid == uid;

      // Students can update their own profile
      allow update: if isRealUser() && request.auth.uid == uid;

      // Students can delete their own profile
      allow delete: if isRealUser() && request.auth.uid == uid;

      // Admins can read all student profiles
      allow read: if isAdmin();
    }

    // ==========================================================================
    // AUDIT LOG (append-only)
    // ==========================================================================
    match /auditLogs/{logId} {
      allow create: if isAdmin() &&
        request.resource.data.get('actorUid', '') == request.auth.uid &&
        request.resource.data.get('action', '').size() > 0 &&
        request.resource.data.get('createdAt', null) == request.time;

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ==========================================================================
    // DEFAULT DENY
    // ==========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/* ==========================================================================
   DEPLOYMENT INSTRUCTIONS FOR FIRESTORE RULES
   ==========================================================================

   1. Go to Firebase Console → Firestore Database → Rules tab
   2. Copy the entire content of this file
   3. Paste into the rules editor
   4. Click "Publish"

   OR use Firebase CLI:
   firebase deploy --only firestore:rules

   REQUIRED INDEXES (create in Firebase Console → Firestore → Indexes):
   - Collection: submissions
     Fields: examId (Ascending), studentEmail (Ascending)
     Query scope: Collection
   - Collection: submissions
     Fields: examId (Ascending), submittedAt (Descending)
     Query scope: Collection
   - Collection: exams
     Fields: createdBy (Ascending), createdAt (Descending)
     Query scope: Collection
*/
