rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================================================
    // SECURITY RULES FOR ONLINE EXAM PLATFORM
    // ==========================================================================
    //
    // IMPORTANT SECURITY TRADEOFF NOTE:
    // ---------------------------------
    // Firestore security rules CANNOT hide specific fields within a document.
    // If a user has read access to a document, they can read ALL fields.
    //
    // In this "no-backend" static-only version:
    // - Correct answers (correctIndex) are stored in the exam document
    // - Students need read access to exams to take them
    // - Therefore, a determined student COULD read correctIndex before submitting
    //
    // MITIGATIONS IN THIS IMPLEMENTATION:
    // 1. Grading happens client-side AFTER submission (not before)
    // 2. Exam documents are only readable during the exam availability window
    // 3. Students only get exam data when they start the exam (via token)
    // 4. For TRUE security (hiding answers completely), you would need:
    //    - A Cloud Function (Firebase Functions) to grade server-side
    //    - Store correct answers in a separate collection only admins can read
    //    - Call the Function on submit, never send correctIndex to client
    //
    // This is a known limitation of client-side-only Firebase apps.
    // For production high-stakes exams, use Cloud Functions.
    //
    // PHASE 0.2 NOTE (post-close review):
    // Published exams stay readable via `get` after their endDate so
    // `exam.html?review=true` can re-render a past attempt (it needs the exam
    // doc + correctIndex). Drafts are NOT readable, and not-yet-open exams are
    // not readable via `get`. However, `list` only checks `status`, so any
    // signed-in user can still list published exams — including future/closed
    // ones — and read correctIndex. That exposure is deferred to Phase 0.3
    // (server-side grading / correctIndex key separation).
    // ==========================================================================

    // Helper functions
    function isAdmin() {
      // Admins are identified by a custom claim granted with the Admin SDK
      // (scripts/set-admin-claim.cjs). A student account can never grant this
      // to itself, and rules stay cheap: no extra document lookup.
      // .get() avoids a rule-evaluation error when the claim is absent
      // (dot access on a missing map key aborts evaluation instead of
      // returning null).
      return request.auth != null && request.auth.token.get('role', '') == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function examExists(examId) {
      return exists(/databases/$(database)/documents/exams/$(examId));
    }

    // A published exam with questions that has started (open or already closed).
    // Used for `get`: review=true must still work after the window closes, so
    // this deliberately ignores endDate. Drafts stay hidden; published
    // future/closed exams remain `list`able (see the 0.2/0.3 note above).
    function isExamReadable(examId) {
      let exam = get(/databases/$(database)/documents/exams/$(examId));
      let start = exam.data.get('startDate', null);
      return exam.data.get('status', '') == 'published' &&
             exam.data.get('questions', []).size() > 0 &&
             (start == null || start <= request.time);
    }

    // A published exam with questions that is inside its availability window.
    // Used for starting/submitting attempts.
    function isExamOpen(examId) {
      let exam = get(/databases/$(database)/documents/exams/$(examId));
      let now = request.time;
      let start = exam.data.get('startDate', null);
      let end = exam.data.get('endDate', null);
      // .get() keeps legacy docs without these fields from aborting evaluation.
      return exam.data.get('status', '') == 'published' &&
             exam.data.get('questions', []).size() > 0 &&
             (start == null || start <= now) &&
             (end == null || end >= now);
    }

    // Allow users to read their own exams (for category loading, dashboard, etc.)
    function isOwnExam() {
      return request.auth != null && resource.data.get('createdBy', '') == request.auth.uid;
    }

    // True when the submission belongs to the caller (uid, or legacy email).
    function isSubmissionOwner() {
      return resource.data.get('studentUid', '') == request.auth.uid ||
             (request.auth.token.get('email', '') != '' &&
              resource.data.get('studentEmail', '') == request.auth.token.get('email', ''));
    }

    // ==========================================================================
    // EXAMS COLLECTION
    // ==========================================================================
    match /exams/{examId} {
      // Admins can create exams
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;

      // Admins can read all exams (for dashboard)
      // Users can read their own exams (for category loading, editing)
      // Students can `get` a started, published exam (taking it, or reviewing a
      // past attempt after the window closes). Drafts and not-yet-open exams are
      // not gettable.
      // get = single doc read (can use resource.data)
      allow get: if isAdmin() || isOwnExam() || (!isAdmin() && isExamReadable(examId));
      // list = query — rules are not filters, so the client query must be
      // provable from the constraints. Students can list every published exam,
      // including future/closed ones; drafts are admin-only. correctIndex in
      // those documents is only closed by Phase 0.3 key separation.
      allow list: if isAdmin() || (isAuthenticated() && resource.data.get('status', '') == 'published');

      // Admins manage ALL exam content. Ownership is deliberately not checked:
      // legacy production exams carry a hardcoded foreign `createdBy` uid
      // (scripts/batch-create-exams.cjs), and a single-tenant product trusts
      // its admins. New exams must still be created under the caller's uid.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // SUBMISSIONS COLLECTION
    // ==========================================================================
    match /submissions/{submissionId} {
      // Students can CREATE a submission (take an exam)
      // They provide: examId, studentName, studentEmail, answers, startedAt
      // Server-side: submittedAt, score, percentage, passed, autoSubmitted are set by client after grading
      allow create: if 
        // Must be for a valid, open exam
        examExists(request.resource.data.examId) &&
        isExamOpen(request.resource.data.examId) &&
        // Must be linked to the authenticated session (anonymous or email)
        request.resource.data.studentUid != null &&
        request.resource.data.studentUid == request.auth.uid &&
        // Student info required
        request.resource.data.studentName != null &&
        request.resource.data.studentName != '' &&
        request.resource.data.studentEmail != null &&
        request.resource.data.studentEmail != '' &&
        // Started timestamp required
        request.resource.data.startedAt != null &&
        // Answers array required
        request.resource.data.answers != null &&
        // Prevent duplicate submissions for same exam+student
        // Note: This requires a composite index or client-side check
        true;

      // Students can READ their own submission (after submitting).
      // Admins can read everything. Legacy submissions that predate
      // `studentUid` are still readable by their auth email, but only when the
      // token actually carries an email (anonymous sessions have none).
      allow get: if isAdmin() || (isAuthenticated() && isSubmissionOwner());
      allow list: if isAdmin() || (isAuthenticated() && isSubmissionOwner());

      // Students can UPDATE their own submission (autosave answers, final submit)
      // The submission is linked to the authenticated session via studentUid, so this
      // works for BOTH anonymous and email/password students (their typed exam email
      // may legitimately differ from their auth account email).
      // Legacy fallback: email/password users whose auth email matches the
      // submission's studentEmail.
      allow update: if 
        isAdmin() ||
        (isAuthenticated() && isSubmissionOwner());

      // No deletes for submissions (audit trail) — admins may clean up, and a
      // student may remove their own draft. Submitted attempts stay immutable.
      allow delete: if isAdmin() ||
        (isAuthenticated() &&
         resource.data.get('studentUid', '') == request.auth.uid &&
         resource.data.get('submittedAt', null) == null);
    }

    // ==========================================================================
    // STUDENTS COLLECTION
    // ==========================================================================
    match /students/{uid} {
      // Students can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == uid;

      // Students can create their own profile (first sign-in)
      allow create: if isAuthenticated() && request.auth.uid == uid;

      // Students can update their own profile
      allow update: if isAuthenticated() && request.auth.uid == uid;

      // Students can delete their own profile
      allow delete: if isAuthenticated() && request.auth.uid == uid;

      // Admins can read all student profiles
      allow read: if isAdmin();
    }

    // ==========================================================================
    // DEFAULT DENY
    // ==========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/* ==========================================================================
   DEPLOYMENT INSTRUCTIONS FOR FIRESTORE RULES
   ==========================================================================
   
   1. Go to Firebase Console → Firestore Database → Rules tab
   2. Copy the entire content of this file
   3. Paste into the rules editor
   4. Click "Publish"
   
   OR use Firebase CLI:
   firebase deploy --only firestore:rules
   
   REQUIRED INDEXES (create in Firebase Console → Firestore → Indexes):
   - Collection: submissions
     Fields: examId (Ascending), studentEmail (Ascending)
     Query scope: Collection
   - Collection: submissions  
     Fields: examId (Ascending), submittedAt (Descending)
     Query scope: Collection
   - Collection: exams
     Fields: createdBy (Ascending), createdAt (Descending)
     Query scope: Collection
*/