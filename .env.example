# Firebase Configuration
# Copy this file to .env.development and .env.production and fill in your values
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app → Config

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Emulator Configuration
# Set to "true" in .env.development to connect to local Firebase emulators
VITE_USE_EMULATOR=false

# App Check (optional) — reCAPTCHA v3 site key from Firebase Console →
# App Check → Apps → reCAPTCHA v3. Leave blank to disable. App Check is only
# initialized when this is set AND VITE_USE_EMULATOR is not "true".
VITE_APPCHECK_SITE_KEY=

# Error monitoring (optional) — Sentry browser DSN. Leave blank to disable;
# js/monitoring.js is a no-op without it and the Sentry chunk is not loaded.
VITE_SENTRY_DSN=
# Sentry environment label. Defaults to Vite's MODE (development/production/staging).
VITE_SENTRY_ENVIRONMENT=