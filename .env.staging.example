# Staging environment (Firebase project: nightingale-staging)
#
# Copy this file to `.env.staging` and fill in the staging web-app config
# (Firebase Console → nightingale-staging → Project settings → Your apps → Web app):
#
#   cp .env.staging.example .env.staging
#   npm run build:staging        # vite build --mode staging
#
# `.env.staging` is a local, uncommitted file and must never be committed.
# (Confirm it is listed in .gitignore before creating it; only the `*.example`
# file belongs in the repo.) Values below are placeholders, not real keys.

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-staging-api-key
VITE_FIREBASE_AUTH_DOMAIN=nightingale-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nightingale-staging
VITE_FIREBASE_STORAGE_BUCKET=nightingale-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:staging0000000000

# Emulator Configuration
# Staging always talks to the real staging project — never the emulators.
VITE_USE_EMULATOR=false

# App Check (optional) — reCAPTCHA v3 site key for the staging app. Leave blank
# to keep App Check off (it has no emulator support).
VITE_APPCHECK_SITE_KEY=

# Error monitoring (optional) — Sentry browser DSN for the staging environment.
# Leave blank to disable: js/monitoring.js is a no-op without it.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
